# ============================================================
# SafeClick Guardian AI - Server Environment Variables
# ============================================================

# MongoDB Connection URI (from MongoDB Atlas)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/safeclick

# Supabase - Server Side (NEVER expose these in the frontend)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Gemini AI API Key
GEMINI_API_KEY=your-gemini-api-key-here

# Server Port
PORT=5000
